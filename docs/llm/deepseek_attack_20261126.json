  {
   "id": "overfill-team-3v3",
   "why": "A team must never hold more places than team_size.",
   "team_size": 3,
   "lobby": true,
   "steps": [
    {
     "client": "A",
     "connect": true
    },
    {
     "client": "A",
     "send": {
      "type": "create_room",
      "seat": "red",
      "lobby": true,
      "team_size": 3,
      "claim": 3
     }
    },
    {
     "client": "B",
     "connect": true
    },
    {
     "client": "B",
     "send": {
      "type": "join",
      "code": "$CODE",
      "seat": "red",
      "claim": 3
     }
    },
    {
     "client": "C",
     "connect": true
    },
    {
     "client": "C",
     "send": {
      "type": "join",
      "code": "$CODE",
      "seat": "red",
      "claim": 1
     }
    }
   ],
   "expect": "The third red join must be refused with team_full because red already holds 3 places."
  },
