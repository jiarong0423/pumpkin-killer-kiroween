    },
    {
     "client": "B",
     "send": {
      "type": "join",
      "code": "$CODE",
      "seat": "auto"
     }
    },
    {
     "client": "A",
     "close": true
    },
    {
     "sleep": 0.1
    },
    {
     "client": "B",
     "send": {
      "type": "begin",
      "on": true
     }
    }
   ],
   "expect": "B receives host_only and the room_state still names A's seat as the single host_seat_id."
