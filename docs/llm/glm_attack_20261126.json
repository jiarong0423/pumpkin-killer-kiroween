  {
   "id": "claim-capped-at-team-size",
   "why": "A seat must not reserve more places than its team has room for.",
   "team_size": 2,
   "lobby": true,
   "steps": [
    {
     "client": "A",
     "connect": true
    },
    {
     "client": "A",
     "send": {
      "type": "create_room",
      "seat": "red",
      "lobby": true,
      "team_size": 2,
      "claim": 3
     }
    }
   ],
   "expect": "The relay seats A without error but caps its claim at 2, so the room_state shows A holding exactly 2 places of the red team."
  },
  {
