  {
   "id": "begin-while-host-away",
   "why": "While the host's seat is only disconnected (in its grace period) nobody else becomes host, so there cannot be two hosts.",
   "team_size": 1,
   "lobby": true,
   "steps": [
    {
     "client": "A",
     "connect": true
    },
