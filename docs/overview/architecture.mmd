  %% inside the game
  B_AI --> B_PHYS
  B_CNEW -.-> B_C4
  B_START --> B_HUD
  B_ULT -.-> B_CNEW
  B_WFX --> B_WGHOST

  %% data into the game
  D_AMAP --> B_AUD
  D_CONST --> B_PHYS
  D_CSTAT -.-> B_C4
  D_I18N -.-> B_HUD

  %% tests into data
  X_JS --> D_MODS
  X_PY --> D_CONST
  X_BAL --> D_CSTAT

  %% art pipeline
  A_COLAB --> A_KEY
  A_IMG2 --> A_KEY
  A_KEY --> A_ASSETS
